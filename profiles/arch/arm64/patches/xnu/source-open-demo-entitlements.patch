@@ -4368,6 +4378,24 @@
 	struct cs_blob *cs_blob)
 {
 	kern_return_t ret = KERN_NOT_SUPPORTED;
+#if XNU_OPEN_SOURCE_DEMO
+	/*
+	 * Separate public-source MockFS demo: no AMFI provider is installed.
+	 * A plain ad-hoc image has no entitlement query context to accelerate.
+	 * Refuse entitlement-bearing and platform/non-ad-hoc images; never
+	 * manufacture an entitlement object or an authentication result.
+	 * Existing CodeDirectory structure and page-hash checks stay intact.
+	 */
+	if (amfi == NULL) {
+		if (!(cs_blob->csb_flags & CS_ADHOC) ||
+		    (cs_blob->csb_flags & CS_PLATFORM_BINARY) ||
+		    cs_blob->csb_entitlements || cs_blob->csb_entitlements_blob ||
+		    cs_blob->csb_der_entitlements_blob) {
+			return EPERM;
+		}
+		return 0;
+	}
+#endif
 
 #if CODE_SIGNING_MONITOR
 	CEQueryContext_t ce_ctx = NULL;
